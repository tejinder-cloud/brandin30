# Required: the Supabase project address and its publishable (browser-safe) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

# Optional. Ten-digit WhatsApp number for the floating chat button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=https://brandin30.in
# Optional. GA4 measurement ID and Microsoft Clarity project ID. Defaults are in src/lib/site.ts; set to empty to switch one off.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
